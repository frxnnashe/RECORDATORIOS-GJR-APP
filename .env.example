MONGODB_URI=
MONGODB_DB=reminders_gjr
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Usar true únicamente con un servidor MongoDB local sin réplica.
# MONGODB_STANDALONE=true

# Iniciar sesión con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recuperar contraseña por correo
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Web Push. Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: con un correo de contacto o una URL HTTPS pública
VAPID_SUBJECT=

# Vercel Schedules
CRON_SECRET=

# Alternativa opcional con un intervalo menor
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
